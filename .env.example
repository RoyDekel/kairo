# KAIRO Environment Variables Example
# Copy this file to .env or .env.production and fill in your values.

# Backend API URL (Default local development: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Ticketmaster Event Intelligence API Key
# SERVER-SIDE ONLY. Deliberately has no VITE_ prefix so Vite can never inline it into
# the public client bundle. If this is unset the backend falls back to simulated events.
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key_here

# TheSportsDB API Key — sports fixtures, cross-referenced with Ticketmaster.
# SERVER-SIDE ONLY. Optional: the provider stays disabled while this is unset.
#
# A PREMIUM key is required. The free key ('123') is rejected on purpose, because the
# free tier limits RESULTS rather than requests: eventsday.php returns just 3 events per
# day for the entire world, which cannot locate a match in a given city. Enabling it
# would look like "no sport on" instead of "this tier can't answer".
# Premium is $9/month: https://www.thesportsdb.com/pricing
THESPORTSDB_API_KEY=

# Supabase Credentials (Required for user authentication, watchlist & sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
