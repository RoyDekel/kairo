# KAIRO Environment Variables Example
# Copy this file to .env or .env.production and fill in your values.

# Backend API URL (Default local development: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Ticketmaster Event Intelligence API Key
# SERVER-SIDE ONLY. Deliberately has no VITE_ prefix so Vite can never inline it into
# the public client bundle. If this is unset the backend falls back to simulated events.
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key_here



# Supabase Credentials (Required for user authentication, watchlist & sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API-Sports (football fixtures) — the event COVERAGE provider.
# SERVER-SIDE ONLY. Optional: the provider stays disabled while this is unset.
#
# The free plan gives 100 requests/day. That is enough because the provider queries
# /fixtures?date= and caches each day's worldwide fixture list BY DATE, so a six-day
# travel window costs six requests shared across all destinations and users.
#
# Note: the free plan blocks league+season queries for the current season
# ("Free plans do not have access to this season, try from 2022 to 2024"), but date
# queries are unaffected and do return current-season fixtures. This provider therefore
# never queries by season.  https://www.api-football.com/pricing
APISPORTS_API_KEY=
