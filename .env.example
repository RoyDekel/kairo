# KAIRO Environment Variables Example
# Copy this file to .env or .env.production and fill in your values.

# Backend API URL (Default local development: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Ticketmaster Event Intelligence API Key
# SERVER-SIDE ONLY. Deliberately has no VITE_ prefix so Vite can never inline it into
# the public client bundle. If this is unset the backend falls back to simulated events.
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key_here



# Supabase Credentials (Required for user authentication, watchlist & sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API-Sports (football fixtures) — the event COVERAGE provider.
# SERVER-SIDE ONLY. Optional: the provider stays disabled while this is unset.
#
# The provider queries /fixtures?date= and caches each day's worldwide fixture list BY
# DATE, so a travel window costs one request per date, shared across all destinations
# and users. It never queries by league+season, which the free plan blocks outright.
#
# THE FREE PLAN CANNOT SERVE THIS FEATURE. An earlier version of this comment claimed
# date queries were exempt from the free plan's season lock. They are not — the lock
# simply presents as a rolling window of roughly today +/- 1 day:
#   "Free plans do not have access to this date, try from 2026-07-30 to 2026-08-01"
# Since KAIRO asks what is on during a future trip, every useful query is refused.
# See APISPORTS_DISABLED below.  https://www.api-football.com/pricing
APISPORTS_API_KEY=

# --- Durable fixture cache (server-side only) -----------------------------------------
# The API-Sports day cache used to live only in process memory. Render's free tier spins
# the service down after ~15 minutes idle and takes that memory with it, so the advertised
# six-hour TTL was fiction: nearly every search was a cold start paying full API cost
# against a 100/day allowance. These point the cache at Supabase, which survives spin-downs
# and deploys and is shared by every instance and user.
#
# Create the table first: supabase/fixtures_cache.sql
#
# SUPABASE_SERVICE_KEY IS NOT THE SAME AS VITE_SUPABASE_ANON_KEY.
#
#   VITE_SUPABASE_ANON_KEY  low privilege, RLS enforced, safe in the browser
#   SUPABASE_SERVICE_KEY    elevated, BYPASSES RLS entirely, full access to all project data
#
# Get it from Supabase: Settings > API Keys. Prefer a new-format secret key (sb_secret_...)
# over the legacy service_role JWT — the new format is additionally rejected with HTTP 401
# if it is ever used from a browser, and the legacy JWT keys are being deprecated.
#
# Pasting the anon key here does not work: RLS applies, this table has no policy, and every
# cache write is denied. The server logs the failure and falls back to memory-only.
#
# NOTE the deliberate absence of a VITE_ prefix. Vite inlines VITE_-prefixed variables into
# the public bundle, so a secret key named that way would ship with the website.
# Without these the cache degrades to memory-only rather than failing.
# Optional: falls back to VITE_SUPABASE_URL, which is the same project and not a secret.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Set to 1 to call the real API-Sports service from local development. Left unset, `npm run
# dev` serves the committed snapshot in server/providers/snapshots/ instead. Manual dev
# searches were the likeliest way to spend the daily allowance, since they happen by hand
# and repeatedly; reaching the live API is now a deliberate act.
APISPORTS_LIVE=

# CURRENTLY SET TO 1 IN PRODUCTION, ON PURPOSE.
#
# Not because of the suspension - that was lifted - but because the free plan cannot serve
# this feature at all. It answers only for roughly today +/- 1 day:
#   "Free plans do not have access to this date, try from 2026-07-30 to 2026-08-01"
# KAIRO asks what is on during a FUTURE trip, so every useful query is refused. A paid plan
# ($19/month at the time of writing) lifts the restriction; nothing else does.
#
# Everything built around this provider - in-flight deduplication, the durable day cache,
# the daily ceiling, the learned plan window - is correct and dormant. Clearing this
# variable is the only step needed to bring it back.
#
# Set to 1 to switch off the provider while leaving APISPORTS_API_KEY in place, so that
# re-enabling is a one-variable change and the logs can still distinguish "switched off"
# from "lost the credential".
#
# With it set, Ticketmaster is the only source. That is enrichment, not coverage — it sees
# events sold through its own channel and nothing else, so club-sold football is invisible.
# The API reports coverage: 'ticketed-only' so the verdict stops arguing "nothing is
# competing for seats" from a source that could not have shown a competitor.
APISPORTS_DISABLED=

# Hard daily ceiling on API-Sports calls, deliberately below the free plan's real 100.
# Defaults to 80. The rate limiter caps requests per MINUTE; nothing capped them per DAY,
# which is the binding constraint and the one the original incident exhausted.
# Requires supabase/api_usage_daily.sql to be durable across restarts.
APISPORTS_DAILY_LIMIT=

# --- Phase 1: fli provider (free Google Flights, reverse-engineered internal API) -----
#
# Package: @punitarani/fli (npm). Note the README of the upstream project advertises
# `fli-js`; that name is not published. Version is pinned exactly on purpose — the library
# depends on an undocumented Google response format, so an unpinned upgrade is an
# unannounced breaking change.
#
# Runs in-process. There is no Python, no sidecar and no subprocess: a shell-out to a
# `python` binary would work locally and fail on every request in production, where the
# Node image has neither the interpreter nor the package.
FLI_ENABLED=true
FLIGHT_PROVIDER=fli

# The single currency every fare is quoted AND stored in.
#
# FareHistory takes medians across fare_observations rows. Mixing currencies in that
# column makes the statistic measure the exchange rate, and the damage is unrecoverable:
# a stored row carries no record of what it should have been converted from. Change this
# and you start a new baseline; you do not extend the old one.
FARE_CURRENCY=USD

# Whether the discovery page ("When to Go") prices destinations with the REAL provider.
#
# Deliberately independent of FLI_ENABLED. A free provider removes the per-search cost but
# not the load: one discovery search fans out to ~31 upstream searches. Keeping this
# separate means the provider can serve /api/flights while the fan-out stays off — which
# is the rollback you want available when the fan-out is the part that misbehaves.
#
# Leave false until the provider has been stable in production for a while.
ESTIMATES_USE_REAL_PROVIDER=false

# Upper bound on simultaneous upstream searches during that fan-out. Unbounded
# Promise.allSettled over 60 destinations is a stampede against a rate-limited endpoint.
ESTIMATES_MAX_CONCURRENCY=6

# --- Phase 2: Scheduled Fare Collector ---
COLLECTOR_ENABLED=false
COLLECTOR_CRON=0 */6 * * *
COLLECTOR_HOME_AIRPORTS=TLV
COLLECTOR_DELAY_MS=2000

# --- Phase 3: Airport Catalog ---
VITE_FEATURED_HUBS=TLV,LHR,CDG,JFK,DXB,FCO,NRT,ATH,BCN,PRG,LIS

# --- Phase 4: Free Sports Fixtures Layer ---
OPENFOOTBALL_ENABLED=false

# --- Phase 5: Time-Series Forecasting Sidecar ---
FORECAST_SIDECAR_URL=http://localhost:3004
FORECAST_MIN_OBSERVATIONS=30

# --- Phase 6: Telemetry & OpenSky ---
OPENSKY_ENABLED=false
OPENSKY_POLL_INTERVAL_MS=15000

# --- Phase 7: Alert Delivery (Telegram / Email) ---
# Alerts are evaluated server-side after each fare collector sweep.
# Notifications are sent directly via Telegram Bot API or SMTP — no Python/Apprise needed.
#
# Telegram: Create a bot via @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=
#
# LOCAL DEVELOPMENT ONLY — leave this unset in production.
#
# notifier.js uses this when an alert carries no chat_id of its own, so it is a
# single process-wide recipient. In production that means one user's alert can be
# delivered to whoever owns this value instead of to the user who created it.
# POST /api/alerts now rejects alerts without a channel_target precisely so this
# fallback stays a convenience for testing delivery, not a routing rule.
TELEGRAM_DEFAULT_CHAT_ID=
#
# Email: any SMTP provider works. The values below are for Brevo's free tier
# (300 emails/day), which is far more than a 24h-rate-limited price alert needs.
#
# Three different addresses are involved here, and confusing them is the usual
# cause of a "working" config that never delivers:
#   SMTP_USER      the relay login — a username, not an inbox
#   SMTP_FROM      the From line recipients see — must be a verified sender
#   channel_target the recipient, stored per-alert in price_alerts
#
# Brevo credentials: Settings > SMTP & API > SMTP tab.
#   - SMTP_USER is the "SMTP login" shown there, e.g. 9a1b2c001@smtp-brevo.com.
#   - SMTP_PASS is an SMTP key, NOT an API key. The two sit on the same page and
#     an API key fails with a 535 that looks identical to a wrong password.
#     The full key is shown once at creation and masked afterwards, so store it
#     when you generate it. Brevo also expires INACTIVE keys after 90 days.
#   - Port 587 is STARTTLS. notifier.js derives `secure` from the port
#     (secure = port === 465), so 587 and 465 both work without another var.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#
# Unlike Gmail — where From and login are the same mailbox and this could be left
# blank — Brevo REQUIRES this to be set. notifier.js falls back to SMTP_USER when
# SMTP_FROM is empty, and Brevo's ...@smtp-brevo.com login is not a valid sender,
# so an unset SMTP_FROM makes every send bounce as an unverified sender.
#
# The address must be confirmed under Senders, Domains & Dedicated IPs > Senders.
# A personal address works, but mail sent as e.g. @gmail.com from Brevo's servers
# fails that domain's DMARC alignment and often lands in spam. Sending from a
# domain you control, with Brevo's DKIM configured, is what fixes that properly.
SMTP_FROM=
